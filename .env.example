# Container and scheduler
TZ=Asia/Tehran
SCHEDULER_START_AT=08:00:00
SCHEDULER_TIME_ZONE_ID=Asia/Tehran

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_ENABLE_WEB_SEARCH=true

# Groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_WRITER_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=5000
GROQ_ENABLE_WRITER_FALLBACK=true
GROQ_FALLBACK_WRITER_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MAX_COMPLETION_TOKENS=4500
GROQ_MINIMUM_ARTICLE_HTML_CHARACTERS=4500
GROQ_REJECT_SHORT_ARTICLES=true
GROQ_ENABLE_WEB_RESEARCH=true
GROQ_RESEARCH_MODEL=groq/compound-mini
GROQ_RESEARCH_MODEL_VERSION=2025-07-23
GROQ_RESEARCH_MAX_COMPLETION_TOKENS=2048
GROQ_RESEARCH_PROMPT_MAX_CHARACTERS=1200
GROQ_MAX_RESEARCH_CHARACTERS=12000
GROQ_CONTINUE_WITHOUT_RESEARCH_ON_FAILURE=true

# LLM providers: OpenAI, Groq, or Fixture
# Image providers: OpenAI, GoogleImages, Pollinations, Fixture, or None
LLM_PROVIDER=OpenAI
IMAGE_PROVIDER=GoogleImages
ARTICLE_PROMPT_FILE_PATH=prompts/article-news-fa.md
GROQ_ARTICLE_PROMPT_FILE_PATH=prompts/article-news-groq-fa.md
IMAGE_PROMPT_FILE_PATH=prompts/article-image-fa.md

# Pollinations image provider. No key is required for the default public endpoint.
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt/
POLLINATIONS_PROMPT_FILE_PATH=prompts/article-image-pollinations-en.md
POLLINATIONS_MODEL=flux
POLLINATIONS_WIDTH=1536
POLLINATIONS_HEIGHT=1024
POLLINATIONS_NO_LOGO=true
POLLINATIONS_PRIVATE=true
POLLINATIONS_SAFE=true
POLLINATIONS_ENHANCE=false
POLLINATIONS_MAX_PROMPT_CHARACTERS=700
POLLINATIONS_MAX_ATTEMPTS=3
POLLINATIONS_RETRY_DELAY_SECONDS=30

# Google Images provider through official Programmable Search JSON API.
GOOGLE_IMAGE_SEARCH_API_KEY=replace-with-google-custom-search-api-key
GOOGLE_IMAGE_SEARCH_ENGINE_ID=replace-with-programmable-search-engine-id
GOOGLE_IMAGE_SEARCH_QUERY_TEMPLATE={focusKeyphrase} {title} technology article
GOOGLE_IMAGE_SEARCH_COUNT=10
GOOGLE_IMAGE_SEARCH_MAX_DOWNLOAD_ATTEMPTS=5
GOOGLE_IMAGE_SEARCH_MAX_QUERY_CHARACTERS=180
GOOGLE_IMAGE_SEARCH_IMAGE_SIZE=large
GOOGLE_IMAGE_SEARCH_SAFE=active
GOOGLE_IMAGE_SEARCH_RIGHTS=
GOOGLE_IMAGE_SEARCH_MAX_IMAGE_BYTES=8000000

# WordPress
WORDPRESS_SITE_URL=https://example.com/
WORDPRESS_USERNAME=wordpress-user
WORDPRESS_APPLICATION_PASSWORD=replace-with-wordpress-application-password
WORDPRESS_POST_STATUS=draft
WORDPRESS_CATEGORY_ID=50
WORDPRESS_REQUIRE_CATEGORY_ID=true

# Instagram
INSTAGRAM_USER_ID=replace-with-instagram-user-id
INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-access-token

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHANNEL_CHAT_ID=@your-channel-username

# Publishing switches
PUBLISH_TO_WORDPRESS=true
PUBLISH_TO_INSTAGRAM=true
PUBLISH_TO_TELEGRAM=true
